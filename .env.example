# ============================================================================
# INTERNWELL SLIET - Environment Configuration Template
# ============================================================================
# NOTE: Because this frontend is deployed statically on GitHub Pages,
# the browser communicates directly with Supabase via its secure REST API.
#
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy Project URL and 'anon' public key.
# 4. Insert them into `js/supabase-config.js` or configure your build.
#
# IMPORTANT SECURITY RULE:
# NEVER put your `service_role` secret key in frontend JavaScript!
# Only the public `anon` key is safe for client-side use with Row Level Security (RLS).
# ============================================================================

# Supabase Project URL (e.g., https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (safe for frontend, protected by RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
